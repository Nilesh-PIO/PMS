{
  "name": "pms-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Patient Management Application - React SPA. Built into PMS/backend/src/PMS.Api/wwwroot so the API and the SPA are same-origin (required by the cookie-auth decision).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
