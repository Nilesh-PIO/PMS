{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "_comment": "ConnectionStrings:Pms is intentionally absent from every committed file. Supply it with `dotnet user-secrets set \"ConnectionStrings:Pms\" \"...\"` locally, or the ConnectionStrings__Pms environment variable in a deployed environment. Until it is supplied, GET /api/health/db answers 503."
  },

  // DEVIATION (F-2) - deliberate, at the user's explicit instruction, NOT an oversight.
  //
  // planning-pms-verification.md F-2 point 2 and section 2 "Environments" require this seed
  // credential to come from user-secrets locally or an environment variable when deployed,
  // and state that no password is ever committed. The user was warned that overriding this
  // departs from both the plan and normal secret handling, and directed that the real seed
  // user name and password be written here, in this tracked file, anyway.
  //
  // CONSEQUENCE, stated plainly: once this file is committed, a working login credential for
  // this application is in git history permanently. Changing the password later does not
  // remove it from history, and anyone with read access to the repository can sign in.
  //
  // The read site is PMS.Api/Startup/InitialUserSeedExtensions.cs, which carries the same
  // note. Configuration precedence is unchanged, so setting the SeedDoctorUser__UserName and
  // SeedDoctorUser__Password environment variables still overrides these values - that is the
  // route back to the plan's design without a code change.
  //
  // The seeder only ever uses these on a database with no AppUser row: it hashes the password
  // (PBKDF2-HMAC-SHA256) before insert, never stores or logs the plaintext, and refuses to run
  // a second time, so it cannot overwrite a password the physician has since changed.
  //
  // RECOMMENDED: change this password after the first sign-in. F-2 deliberately does not build
  // a forced-rotation flow (out of scope; password change/recovery is F-21, Blocked on C-44),
  // so rotating it today means updating the AppUsers row directly.
  //
  // The section is named SeedDoctorUser, distinct from ConnectionStrings above, so that the
  // one credential deliberately committed here is never mistaken for the connection string,
  // which is still supplied by user-secrets and is still never committed.
  "SeedDoctorUser": {
    "_deviation": "Committed in plain text by explicit user instruction, overriding the plan's user-secrets design. See the comment above and InitialUserSeedExtensions.cs. Committing this file places a real login credential in git history.",
    "UserName": "doctor",
    "Password": "SeedDoctor#2026!"
  }
}
