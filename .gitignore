# ---------------------------------------------------------------------------
# The application lives under PMS/ (PMS/backend and PMS/frontend). The bare
# backend/ and frontend/ patterns are kept so nothing slips through if a stray
# build is ever run from the repo root.
# ---------------------------------------------------------------------------

# .NET
**/bin/
**/obj/
*.user
*.suo

# React / Node
node_modules/
PMS/frontend/dist/
PMS/frontend/build/
npm-debug.log*

# Built React bundle - generated by `npm run build` in PMS/frontend, never committed
PMS/backend/src/PMS.Api/wwwroot/

# Playwright
PMS/backend/tests/PMS.E2E/test-results/
PMS/backend/tests/PMS.E2E/playwright-report/
PMS/backend/tests/PMS.E2E/blob-report/
PMS/backend/tests/PMS.E2E/.playwright/

# Test output
TestResults/
*.trx
coverage/

# IDE / OS
.vs/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Env / secrets - the connection string is supplied by user-secrets or an
# environment variable and never appears in a committed file (F-1 AC 4)
*.env
*.env.local
appsettings.*.local.json
secrets.json
